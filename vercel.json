{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/push/cron?slot=morning",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/push/cron?slot=evening",
      "schedule": "30 18 * * *"
    }
  ]
}
